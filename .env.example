# ==============================================================================
# Google Cloud Enterprise Agent Governance - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values before running scripts:
#   cp .env.example .env && source .env

# Core Google Cloud Identifiers
export PROJECT_ID="your-gcp-project-id"
export PROJECT_NUMBER="000000000000"
export ORGANIZATION_ID="000000000000"
export REGION="us-central1"

# Billing & Quota Overrides for Sensitive Data Protection (DLP) & Model Armor
export USER_PROJECT_OVERRIDE="true"
export GOOGLE_BILLING_PROJECT="${PROJECT_ID}"

# Application & Runtime Identifiers
export AGENT_NAME="hello-world-agent"
export MCP_TOOL_SERVICE_NAME="agents-everywhere-sample-tool"
export TARGET_MODEL_NAME="gemini-3.5-flash"

# Zero-Trust Networking & Gateway Configuration
export VPC_NETWORK_NAME="governed-agent-vpc"
export SUBNET_NAME="agent-private-subnet"
export NETWORK_ATTACHMENT_NAME="gateway-egress-na"
export AGENT_GATEWAY_NAME="gateway-egress"
export ARTIFACT_REGISTRY_REPO="agent-repo"

# Model Armor & Sensitive Data Protection (DLP) Template Identifiers
export MODEL_ARMOR_REQUEST_TEMPLATE_ID="agw-request-template"
export MODEL_ARMOR_RESPONSE_TEMPLATE_ID="agw-response-template"
export MODEL_ARMOR_INSPECT_TEMPLATE_ID="agw-ssn-inspect-template"
export MODEL_ARMOR_DEIDENTIFY_TEMPLATE_ID="agw-ssn-redaction-template"

# Dynamic Runtime Values (Populated after deployment)
export INSTANCE_ID="your-reasoning-engine-instance-id"
export MCP_SERVER_UUID="agentregistry-00000000-0000-0000-0000-000000000000"
export AGENT_REGISTRY_ENDPOINT="https://agentregistry.googleapis.com/v1alpha/projects/${PROJECT_ID}/locations/${REGION}"
export MCP_INVOKER_SA_EMAIL="${PROJECT_NUMBER}-compute@developer.gserviceaccount.com"
export OIDC_ROUTING_MODE="native"
